NODE_ENV=development
PORT=3333
LOG_LEVEL=info
# Número de proxies reversos à frente da API (0 = acesso direto)
TRUST_PROXY=0
# Origens permitidas, separadas por vírgula
CORS_ORIGINS=http://localhost:5173

# Supabase > Project Settings > Database > Connection string (Session pooler, porta 5432).
# Não inclua ?sslmode na URL: o SSL é controlado por DATABASE_SSL.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# disable | no-verify | verify-full (verify-full: informe o CA do Supabase em DATABASE_CA_CERT_PATH)
DATABASE_SSL=no-verify
DATABASE_CA_CERT_PATH=
DATABASE_POOL_MAX=10

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-uma-string-aleatoria-de-pelo-menos-32-caracteres
JWT_TTL_SECONDS=28800

# Convites de funcionários
# Endereço do frontend usado no link do convite
APP_URL=http://localhost:5173
# Chave em https://resend.com/api-keys. Sem ela os e-mails não saem e o link fica disponível na tela Equipe.
RESEND_API_KEY=
# Remetente: precisa ser de um domínio verificado no Resend (onboarding@resend.dev só entrega para o dono da conta)
EMAIL_FROM=SyncroHub <onboarding@resend.dev>
# Validade do link do convite, em horas (padrão: 7 dias)
INVITE_TTL_HOURS=168
